{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Ctrl+Shift+V -> copycat paste",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["control", "shift"] }
                                },
                                "to": [{ "shell_command": "$(set -a && source $HOME/.config/copycat/config.env && $COPYCAT_PYTHONPATH/python3 $COPYCAT_HOME/client/paste.py | pbcopy && osascript -e 'tell application \"System Events\" to keystroke \"v\" using command down')" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+Shift+C -> copycat copy",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["control", "shift"] }
                                },
                                "to": [{ "shell_command": "set -a && source $HOME/.config/copycat/config.env && osascript $COPYCAT_HOME/client/mac/copycat-copy.scpt" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Command + Shift + V -> type clipboard content",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "osascript -e 'set clipText to the clipboard' -e 'tell application \"System Events\" to keystroke clipText'" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}