{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Control+Shift+C -> copycat copy",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["control", "shift"] }
                                },
                                "to": [{ "shell_command": "osascript $HOME/.config/copycat/integration/copycat-copy.scpt" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Control+Shift+V -> copycat paste",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["control", "shift"] }
                                },
                                "to": [{ "shell_command": "$HOME/.local/bin/copycat ps && osascript -e 'tell application \"System Events\" to keystroke \"v\" using control down'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Command+Shift+V-> type clipboard content",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [{ "shell_command": "osascript -e 'set clipText to the clipboard' -e 'tell application \"System Events\" to keystroke clipText'" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}