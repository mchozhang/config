{
  "tools": [
    {
      "name": "brew",
      "enabled": true,
      "install-priority": 80,
      "install": {
        "macos": "install-brew\n"
      },
      "bootstrap": [
        {
          "priority": 80,
          "default": "export PATH=\"$(brew --prefix)/bin:$PATH\"\n"
        }
      ]
    },
    {
      "name": "uv",
      "enabled": true,
      "install-priority": 90,
      "install": {
        "macos": "brew-install uv\n"
      }
    },
    {
      "name": "python3",
      "enabled": true,
      "install-priority": 90,
      "install": {
        "macos": "install-python 3.14\n"
      },
      "bootstrap": [
        {
          "priority": 90,
          "default": "export PATH=\"$HOME/.local/bin:$PATH\"\n"
        }
      ]
    },
    {
      "name": "powerlevel10k",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "default": "git-install https://github.com/romkatv/powerlevel10k.git \"${HOME}/opt/powerlevel10k\"\n"
      },
      "bootstrap": [
        {
          "priority": 70,
          "default": "if [[ -r \"${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh\" ]]; then\n  source \"${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh\"\nfi\n"
        },
        {
          "priority": 100,
          "default": "source \"${HOME}/opt/powerlevel10k/powerlevel10k.zsh-theme\"\nsource \"${HOME}/.p10k.zsh\"\n"
        }
      ]
    },
    {
      "name": "fzf",
      "enabled": true,
      "install": {
        "macos": "brew-install fzf\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "source <(fzf --zsh)\nsource \"$HOME/.config/fzf/.fzf.zsh\"\n"
        }
      ]
    },
    {
      "name": "yazi",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "macos": "brew-install yazi\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "function y() {\n  local tmp=\"$(mktemp -t \"yazi-cwd.XXXXXX\")\" cwd\n  yazi \"$@\" --cwd-file=\"$tmp\"\n  if cwd=\"$(command cat -- \"$tmp\")\" && [ -n \"$cwd\" ] && [ \"$cwd\" != \"$PWD\" ]; then\n    builtin cd -- \"$cwd\"\n  fi\n  rm -f -- \"$tmp\"\n}\n"
        }
      ]
    },
    {
      "name": "fast-syntax-highlighting",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "default": "git-install https://github.com/zdharma-continuum/fast-syntax-highlighting.git \"${HOME}/opt/fast-syntax-highlighting\"\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "source \"${HOME}/opt/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh\"\n"
        }
      ]
    },
    {
      "name": "zsh-autosuggestions",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "default": "git-install https://github.com/zsh-users/zsh-autosuggestions.git \"${HOME}/opt/zsh-autosuggestions\"\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "source \"${HOME}/opt/zsh-autosuggestions/zsh-autosuggestions.zsh\"\n"
        }
      ]
    },
    {
      "name": "fzf-tab-completion",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "default": "git-install https://github.com/lincheney/fzf-tab-completion.git \"${HOME}/opt/fzf-tab-completion\"\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "source \"${HOME}/environment/fzf-tab-completion/zsh/fzf-zsh-completion.sh\"\nbindkey '^I' fzf_completion # Tab key\n"
        }
      ]
    },
    {
      "name": "bash-my-aws",
      "enabled": true,
      "install-priority": 100,
      "install": {
        "default": "git-install https://github.com/mbailey/bash-my-aws.git \"${HOME}/opt/bash-my-aws\"\n"
      },
      "bootstrap": [
        {
          "priority": 100,
          "default": "export BMA_HOME=\"${HOME}/opt/bash-my-aws\"\nexport PATH=\"$PATH:${BMA_HOME}/bin\"\nexport BMA_COLUMNISE_ONLY_WHEN_TERMINAL_PRESENT=true\nsource ${BMA_HOME}/aliases\nsource ${BMA_HOME}/bash_completion.sh\n"
        }
      ]
    }
  ]
}
